[Unit]
Description=YouTube IPTV Proxy
After=network.target

[Service]
Type=simple

Environment=YTPROXY_HOST=127.0.0.1
Environment=YTPROXY_PORT=8090
#Environment=YTPROXY_BG_REFRESH=yes
ExecStart=/usr/bin/ytproxy

Restart=on-failure
RestartSec=5

# Optional hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
